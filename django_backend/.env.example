# Environment variables for production deployment
# Copy this to .env and fill in your production values

# Django Configuration
SECRET_KEY=your-super-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=your-app-name.appspot.com,your-custom-domain.com

# Database Configuration (Cloud SQL PostgreSQL)
DATABASE_URL=postgresql://username:password@/dbname?host=/cloudsql/your-project:region:instance-name

# Blockchain Configuration
BLOCKCHAIN_NETWORK=mainnet
BLOCKCHAIN_PROVIDER_URL=https://mainnet.infura.io/v3/your-infura-key
BLOCKCHAIN_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
BLOCKCHAIN_PRIVATE_KEY=your-private-key-for-blockchain-transactions
BLOCKCHAIN_GAS_LIMIT=500000
BLOCKCHAIN_GAS_PRICE=20000000000

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-esp32-domain.com,https://your-frontend-domain.com

# Redis Configuration
REDIS_URL=redis://your-redis-instance:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://your-redis-instance:6379/0
CELERY_RESULT_BACKEND=redis://your-redis-instance:6379/0

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your-gcp-project-id